}

void tsekL_allocate_time(tsekIContext* context, double framerate, double start, double end) {
  double frametime = 1000 / framerate;
  double elapsed_time = 1000 * (end - start);

  double ease = 0;
  double sleep_time = frametime - elapsed_time - ease;

  if (sleep_time > 0) {
  usleep(sleep_time);
  }
}

